# ============================================================
# Club de Billares Guayabal (Django) — variables de entorno
# ============================================================
# Clave secreta larga y aleatoria (obligatoria en producción):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# "1" solo en desarrollo local
DJANGO_DEBUG=0
# Dominios separados por coma
DJANGO_ALLOWED_HOSTS=www.su-dominio.com,su-app.onrender.com
# PostgreSQL de producción (Render, Railway, Neon, Supabase…)
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
# URL pública del sitio
SITE_URL=https://www.su-dominio.com
# Google Analytics 4 (opcional)
GA_ID=
